SCRCPYCAT_PUBLIC_URL=https://your-domain.example
SCRCPYCAT_JWT_SECRET=replace-with-at-least-48-random-bytes
SCRCPYCAT_ADMIN_USERNAME=admin
SCRCPYCAT_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SCRCPYCAT_AGENT_HELLO_TIMEOUT=10s
SCRCPYCAT_AGENT_HELLO_MAX_BYTES=65536
SCRCPYCAT_MAX_PENDING_AGENT_HANDSHAKES=64
SCRCPYCAT_LOGIN_ATTEMPT_WINDOW=15m
SCRCPYCAT_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=10
SCRCPYCAT_LOGIN_MAX_ATTEMPTS_PER_IP=60
# Only list reverse proxies that sanitize X-Forwarded-For, for example: 10.0.0.0/8
SCRCPYCAT_TRUSTED_PROXY_CIDRS=
# Create this in the admin deployment page after starting the control plane.
# Deployment credentials default to no expiration; they can be revoked there.
SCRCPYCAT_DEPLOYMENT_TOKEN=
SCRCPYCAT_TURN_USERNAME=scrcpycat
SCRCPYCAT_TURN_CREDENTIAL=replace-with-a-unique-turn-password
SCRCPYCAT_TURN_REALM=your-domain.example
SCRCPYCAT_TURN_PUBLIC_IP=your-reachable-server-ip
SCRCPYCAT_TURN_RELAY_IP=0.0.0.0
SCRCPYCAT_TURN_URLS=turn:your-reachable-server-ip:3478?transport=udp,turn:your-reachable-server-ip:3478?transport=tcp
SCRCPYCAT_POSTGRES_PASSWORD=replace-with-a-unique-database-password
SCRCPYCAT_TASK_TTL=24h
SCRCPYCAT_AUDIT_RETENTION=2160h
SCRCPYCAT_MAX_ASSET_BYTES=2147483648
SCRCPYCAT_ADB_FORCE=false
# host: Linux Agent over USB; device: inject a standalone Android Agent.
SCRCPYCAT_ADB_MODE=host
# ADB Server USB backend: 0 = native Linux polling, 1 = libusb hotplug.
SCRCPYCAT_ADB_LIBUSB=0
# Optional: reuse an existing host key directory instead of the adb-keys volume.
# SCRCPYCAT_ADB_KEY_DIR=/root/.android
# Use an address reachable from Android too when selecting device mode.
SCRCPYCAT_AGENT_SIGNALING_URL=wss://your-domain.example/register_agent
# adb-deployer uses host networking; Compose service DNS is not available here.
SCRCPYCAT_CONTROLPLANE_URL=http://127.0.0.1:8443
SCRCPYCAT_HTTP_PORT=8080
SCRCPYCAT_CONTROLPLANE_PORT=8443
# Published images include the Android Agent and scrcpy server artifacts.
# Override these only when building a matching local image from source.
SCRCPYCAT_IMAGE=ghcr.io/cwithw/scrcpycat:latest
SCRCPYCAT_ADB_IMAGE=ghcr.io/cwithw/scrcpycat-adb-deployer:latest
