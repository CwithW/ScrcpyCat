BIN_DIR ?= /out
ANDROID_API ?= 21
ANDROID_NDK_HOME ?=
ANDROID_TOOLCHAIN := $(ANDROID_NDK_HOME)/toolchains/llvm/prebuilt/linux-x86_64/bin

.PHONY: build-agent

build-agent:
	mkdir -p $(BIN_DIR)/arm64-v8a $(BIN_DIR)/armeabi-v7a $(BIN_DIR)/x86_64 $(BIN_DIR)/x86
	CC=$(ANDROID_TOOLCHAIN)/aarch64-linux-android$(ANDROID_API)-clang CGO_ENABLED=1 GOOS=android GOARCH=arm64 go build -trimpath -ldflags="-s -w -checklinkname=0" -o $(BIN_DIR)/arm64-v8a/scrcpycat-agent ./agent/cmd/agent
	CC=$(ANDROID_TOOLCHAIN)/armv7a-linux-androideabi$(ANDROID_API)-clang CGO_ENABLED=1 GOOS=android GOARCH=arm GOARM=7 go build -trimpath -ldflags="-s -w -checklinkname=0" -o $(BIN_DIR)/armeabi-v7a/scrcpycat-agent ./agent/cmd/agent
	CC=$(ANDROID_TOOLCHAIN)/x86_64-linux-android$(ANDROID_API)-clang CGO_ENABLED=1 GOOS=android GOARCH=amd64 go build -trimpath -ldflags="-s -w -checklinkname=0" -o $(BIN_DIR)/x86_64/scrcpycat-agent ./agent/cmd/agent
	CC=$(ANDROID_TOOLCHAIN)/i686-linux-android$(ANDROID_API)-clang CGO_ENABLED=1 GOOS=android GOARCH=386 go build -trimpath -ldflags="-s -w -checklinkname=0" -o $(BIN_DIR)/x86/scrcpycat-agent ./agent/cmd/agent
